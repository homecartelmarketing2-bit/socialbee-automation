# ─── Airtable ─────────────────────────────────────────────────
# Get your token at: https://airtable.com/create/tokens
AIRTABLE_API_TOKEN=your_airtable_api_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_ID=your_airtable_table_id
AIRTABLE_FIELD_NAME=Blended Image

# ─── OpenRouter (AI captions) ────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# ─── Browser paths ────────────────────────────────────────────
# Path to Brave or Chrome executable
BRAVE_PATH=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
BRAVE_USER_DATA=C:/Users/YourUser/AppData/Local/BraveSoftware/Brave-Browser/User Data
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# ─── Zoho WorkDrive (optional, for video uploads) ────────────
# Create a self-client at: https://api-console.zoho.com/
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
